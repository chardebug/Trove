<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Trove.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="175" d:DesignHeight="450"
             x:Class="Trove.Views.SidePanel"
             x:DataType="vm:SidePanelViewModel">

    <StackPanel>

        <Button Content="☰"
                Width="30"
                Margin="10"
                Background="#D45F79"
                Foreground="#FFC59E"
                HorizontalAlignment="Right"
                VerticalAlignment="Top" 
                Command="{Binding TogglePaneCommand}"/>

        <TextBlock Text="Trove"
            HorizontalAlignment="Center"
            FontSize="35"
            Foreground="#7DDEE7"
            FontFamily="fonts:MyFonts#Modern Antiqua"
            IsVisible="{Binding IsOpen}"/>

        <TextBox Text="{Binding SearchText}"
            Margin="40"
            PlaceholderText="Search"
            IsVisible="{Binding IsOpen}"/>

    </StackPanel>   
</UserControl>
