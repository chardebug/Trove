<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="Trove.Views.VideoPlayer"
        Title="Trove Player" Width="960" Height="540">

    <!--bottom bar for seeking and pause/play-->
    <vlc:VideoView x:Name="VideoView">

        <Panel x:Name="Overlay" Background="Transparent">
            <Border x:Name="ControlBar" VerticalAlignment="Bottom" Background="#67000000">
                <Border.Transitions>
                    <Transitions>
                        <!-- Control bar fade-in animation-->
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                    </Transitions>
                </Border.Transitions>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button x:Name="PlayPauseButton" Width="30" Content="⏸" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" />
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="0:00" VerticalAlignment="Center" Foreground="White" Margin="5" />
                    <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" Foreground="White" Margin="5" />
                    <TextBlock x:Name="LengthText" Grid.Column="3" Text="0:00" VerticalAlignment="Center" Foreground="White" Margin="5" />
                </Grid>
            </Border>
        </Panel>

    </vlc:VideoView>

</Window>