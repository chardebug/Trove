<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trove.ViewModels"
        xmlns:views="using:Trove.Views"
        xmlns:converters="using:Trove.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Trove.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Trove">
    
    <Window.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmapConverter"/>
    </Window.Resources>

    <Window.Background>
        <ConicGradientBrush Center="30%,55%" Angle="35" >
            <GradientStop Color="#7DDEE7" Offset="0.0"/>
            <GradientStop Color="#D45F79" Offset="0.2"/>
            <GradientStop Color="#CB6251" Offset="0.55"/>
            <GradientStop Color="#7DDEE7" Offset="1.0"/>
        </ConicGradientBrush>
    </Window.Background>

    <Grid>
    <!-- SplitView Layout -->
        <SplitView IsPaneOpen="{Binding IsPaneOpen}"
                DisplayMode="CompactInline"
                OpenPaneLength="175"
                CompactPaneLength="50"
                PaneBackground="#2D6478">
        
            <SplitView.Pane>
                <views:SidePanel DataContext="{Binding SidePanel}" />
            </SplitView.Pane>
    
            <SplitView.Content>
                <!-- Top bar -->
                <DockPanel>
            
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="5" ColumnSpacing="5">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                        <StackPanel.Styles>
            
                            <Style Selector="Button">
                                <Setter Property="MinWidth" Value="70"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Styles>

                        <Button Content="Select"
                            Background="#D45F79"
                            Foreground="#FFC59E"
                            FontFamily="fonts:MyFonts#Roboto"
                            IsVisible="{Binding IsSelectButtonVisible}"
                            Command="{Binding ToggleSelectionModeCommand}" />
                        <Button Content="Cancel"
                            Background="#3F99A1"
                            Foreground="#276377"
                            FontFamily="fonts:MyFonts#Roboto"
                            IsVisible="{Binding IsCancelButtonVisible}"
                            Command="{Binding CancelCommand}" />
                        <Button Content="Delete"
                            Background="#D45F79"
                            Foreground="#FFC59E"
                            FontFamily="fonts:MyFonts#Roboto"
                            IsVisible="{Binding IsDeleteButtonVisible}"
                            Command="{Binding OpenConfirmationCommand}" />
                    </StackPanel>

                    <TextBox Grid.Column="1"
                        Background="#8F3F99A1"
                        Foreground="#1D4958"
                        FontFamily="fonts:MyFonts#Roboto"
                        BorderThickness="0"
                        Text="{Binding SearchText}"
                        PlaceholderText="Search by title..."
                        VerticalContentAlignment="Center"
                        InnerRightContent="⌕  " />

                    <Button Grid.Column="2" Content="+"
                        Width="30"
                        Background="#D45F79"
                        Foreground="#FFC59E"
                        Command="{Binding OpenPopUpCommand}" />
                </Grid>

                <TextBlock DockPanel.Dock="Top"
                    Text="{Binding StatusMessage}"
                    Foreground="#8B0000"
                    Margin="8,0"
                    TextWrapping="Wrap" />

            <!-- Main content block -->
                <ScrollViewer>
                    <!-- Main collection of videos -->
                    <ItemsControl ItemsSource="{Binding Videos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- The video container is defined here -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    
                                        <!--Video container is a button in order to play videos-->
                                        <Grid Width="150" Height="225" Margin="20">
                                            <Grid.Styles>
                                                <!--Hide the play button by default-->
                                                <Style Selector="Button.PlayOverlay">
                                                    
                                                    <Setter Property="Opacity" Value="0" />
                                                       
                                                </Style>

                                                <!-- Keeps the background consistent when hovering the button itself -->
                                                <Style Selector="Button.PlayOverlay:pointerover">
                                                    
                                                    <Setter Property="Opacity" Value="1" />
                                                </Style>

                                                <Style Selector="Button.PlayOverlay:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#88000000"/>
                                                </Style>

                                            </Grid.Styles>

                                            <!--Background image-->
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmapConverter}}" 
                                                Stretch="UniformToFill" />
                                            <!--Button Overlay-->
                                            <Button Classes="PlayOverlay"
                                                Height="225"
                                                Width="150"
                                                CornerRadius="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CanPlay}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PlayVideoCommand}"
                                                CommandParameter="{Binding}">

                                                <PathIcon Data="M 0 0 L 20 10 L 0 20 Z" 
                                                    Width="24" 
                                                    Height="24" 
                                                    Foreground="White"/>

                                            </Button>
                                            <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5, 5"
                                                      IsVisible="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).IsSelectionMode}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </Grid>
                                    
                                    <TextBlock Text="{Binding Title}" Width="145" Height="50" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            

            </DockPanel>

            </SplitView.Content>
            
             
        </SplitView>
        <!-- Video add Pop-Up -->
        <Grid IsVisible="{Binding IsPopUpVisible}" Background="#80000000">
        <Border Background="#2D6478"
        CornerRadius="10"
        Padding="10"
        Width="350"
        Height="250"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
            <Canvas
                >
                <TextBlock 
                    Text="New Video"
                    FontFamily="fonts:MyFonts#Modern Antiqua"
                    Foreground="#7DDEE7"
                    Canvas.Left="130"
                    Canvas.Top="10" />
                <Button
                    Content="x"
                    Canvas.Right="5"
                    Canvas.Top="5"
                    Width="30"
                    Background="#D45F79"
                    Foreground="#FFC59E"
                    Command="{Binding ClosePopUpCommand}" />
                <Button
                    Content="Upload Video"
                    FontFamily="fonts:MyFonts#Roboto"
                    Background="#D45F79"
                    Foreground="#FFC59E"
                    Canvas.Left="20"
                    Canvas.Top="50"
                    Width="133"
                    HorizontalContentAlignment="Center"
                    Command="{Binding OpenVideoFileCommand}" />
                <TextBlock 
                    Text="{Binding VideoFileName}" 
                    TextTrimming="CharacterEllipsis"
                    FontSize="10"
                    Width="150"
                    Foreground="White" 
                    Canvas.Left="160" 
                    Canvas.Top="57" />
                <Button
                    Content="Upload Thumbnail"
                    FontFamily="fonts:MyFonts#Roboto"
                    Background="#D45F79"
                    Foreground="#FFC59E"
                    Canvas.Left="20"
                    Canvas.Top="90"
                    Command="{Binding OpenThumbnailFileCommand}" />
                <TextBlock 
                    Text="{Binding ThumbnailFileName}" 
                    TextTrimming="CharacterEllipsis"
                    FontSize="10"
                    Width="150"
                    Foreground="White" 
                    Canvas.Left="160" 
                    Canvas.Top="95" />
                
                <TextBlock
                    Text="Title:"
                    Foreground="White"
                    Canvas.Left="20"
                    Canvas.Top="135"
                     />
                <TextBox Text="{Binding VideoTitle}"
                        BorderBrush="#7DDEE7"
                        Canvas.Left="60"
                        Canvas.Top="132"
                        Width="265" />
                
                <Button
                    Content="Add Video"
                    Command="{Binding AddVideoCommand}"
                    FontFamily="fonts:MyFonts#Roboto"
                    Background="#D45F79"
                    Foreground="#FFC59E"
                    HorizontalAlignment="Center"
                    Canvas.Bottom="15"
                    Canvas.Left="125" />

    
            </Canvas>
        </Border>
        </Grid>
        <!-- Confirmation pop-up -->
        <Grid IsVisible="{Binding IsConfirmationVisible}" Background="#80000000">
            <Border Background="#2D6478"
                CornerRadius="10"
                Padding="10"
                Width="350"
                Height="150"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            </Border>
            <Grid ColumnDefinitions="100,*" RowDefinitions="30,*,*" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" 
                    Text=" Delete the Selected Video(s)?"  
                    Foreground="#7DDEE7" 
                    FontFamily="fonts:MyFonts#Modern Antiqua"
                    FontSize="15" 
                    HorizontalAlignment="Center"/>
                <Button Width="80" Grid.Column="0" Grid.Row="1" HorizontalContentAlignment="Center"
                    Content="Cancel"
                    Command="{Binding CloseConfirmationCommand}"
                    FontFamily="fonts:MyFonts#Roboto"
                    HorizontalAlignment="Center"
                    Background="#3F99A1"
                    Foreground="#1D4958" />
                <Button Width="80" Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Center"
                    Content="Delete" 
                    Command="{Binding ConfirmDeleteCommand}"
                    FontFamily="fonts:MyFonts#Roboto" 
                    HorizontalAlignment="Center" 
                    Background="#D45F79"
                    Foreground="#FFC59E"/>

            </Grid> 
        </Grid>                         
    </Grid>

</Window>
